SECRET_KEY=replace-this-with-a-unique-random-secret-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=
# Set to 31536000 only after HTTPS is confirmed for this host.
SECURE_HSTS_SECONDS=0

DB_NAME=dejavu_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
# Outside Docker use localhost; docker-compose overrides this to "db"
DB_HOST=localhost
DB_PORT=5432

WEB_PORT=8000
